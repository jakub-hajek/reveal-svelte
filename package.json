{
	"name": "reveal-svelte",
	"version": "0.1.0",
	"description": "Reveal.js presentation components for Svelte 5 — slides, layouts, charts, markdown, math, code and Excalidraw diagrams.",
	"license": "MIT",
	"type": "module",
	"svelte": "./dist/index.js",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme/reveal-base.css": "./dist/theme/reveal-base.css",
		"./theme/variables.css": "./dist/theme/variables.css",
		"./theme/reveal.css": "./dist/theme/reveal.css",
		"./theme/base.css": "./dist/theme/base.css",
		"./theme/catppuccin/theme.css": "./dist/theme/catppuccin/theme.css"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"package": "svelte-kit sync && svelte-package && publint",
		"release": "bun run package && bun run test:unit",
		"test": "bun run test:unit && bun run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@catppuccin/palette": "^1.7.1",
		"@excalidraw/utils": "0.1.3-test32",
		"chart.js": "^4.5.1",
		"dompurify": "^3.3.0",
		"katex": "^0.16.25",
		"marked": "^16.4.1",
		"reveal.js": "^5.2.1",
		"svelte-highlight": "^7.9.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/package": "^2.3.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/dompurify": "^3.0.5",
		"@types/katex": "^0.16.7",
		"@types/node": "^25.2.3",
		"@types/reveal.js": "^5.2.1",
		"@vitest/coverage-v8": "^4.0.18",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.5",
		"globals": "^16.4.0",
		"jsdom": "^28.0.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"publint": "^0.3.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.46.2",
		"vite": "^5.0.0",
		"vitest": "^4.0.18"
	}
}
